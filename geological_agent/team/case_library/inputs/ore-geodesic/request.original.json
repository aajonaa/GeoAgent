{
  "coordinate_reference": "EPSG:4326",
  "operations": [
    {
      "operation_id": "=distance",
      "tool": "GeoHaversineDistance",
      "arguments": {
        "lat1": 0,
        "lon1": 0,
        "lat2": 0,
        "lon2": 90
      }
    },
    {
      "operation_id": "bearing",
      "tool": "GeoBearing",
      "arguments": {
        "lat1": 0,
        "lon1": 0,
        "lat2": 0,
        "lon2": 90
      }
    },
    {
      "operation_id": "coord",
      "tool": "GeoDecimalToDMS",
      "arguments": {
        "value": -179.9999999,
        "axis": "lon"
      }
    },
    {
      "operation_id": "area",
      "tool": "GeoWGS84BBoxAreaKm2",
      "arguments": {
        "min_lon": 0,
        "min_lat": 0,
        "max_lon": 1,
        "max_lat": 1
      }
    },
    {
      "operation_id": "crs",
      "tool": "GeoCheckCRSConsistency",
      "arguments": {
        "crs_values": [
          "epsg:4326",
          "EPSG:4326"
        ]
      }
    }
  ]
}
