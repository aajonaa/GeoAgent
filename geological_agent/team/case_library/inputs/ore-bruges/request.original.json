        "vp_m_s": [
          2000,
          3000,
          2500
        ],
        "vs_m_s": [
          1000,
          1500,
          1250
        ],
        "density_kg_m3": [
          2000,
          2400,
          2200
        ],
        "incidence_degrees": [
          0,
          20
        ],
        "shear_p_ratio": 0.5
      }
    },
    {
      "operation_id": "r",
      "call_name": "SeismicReflectivity",
      "arguments": {
        "vp": [
          2000,
          3000,
          2500
        ],
        "density": [
          2.0,
          2.4,
          2.2
        ]
      }
    },
    {
      "operation_id": "c",
      "call_name": "GeoSeismicWindowCoherence",
      "arguments": {
