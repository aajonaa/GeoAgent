{
  "coordinate_reference": "EPSG:4326",
  "operations": [
    {
      "operation_id": "coord",
      "tool": "CCSDecimalToDMS",
      "arguments": {
        "value": 42.5,
        "field": "lat"
      }
    },
    {
      "operation_id": "distance",
      "tool": "CCSHaversineDistance",
      "arguments": {
        "lat1": 0,
        "lon1": 0,
        "lat2": 0,
        "lon2": 90
      }
    },
    {
      "operation_id": "bearing",
      "tool": "CCSBearing",
      "arguments": {
        "lat1": 0,
        "lon1": 0,
        "lat2": 0,
        "lon2": 90
      }
    },
    {
      "operation_id": "area",
      "tool": "CCSBBoxArea",
      "arguments": {
        "bbox": [
          0,
          0,
          1,
          1
        ]
      }
    },
    {
      "operation_id": "labels",
      "tool": "CCSCheckCRSConsistency",
      "arguments": {
        "crs_values": [
          "EPSG:4326",
          "epsg:4326"
        ]
      }
    }
  ]
}
