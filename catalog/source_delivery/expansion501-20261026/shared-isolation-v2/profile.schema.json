{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Admin CPU v2 profiles (empty registry is the shipped example)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "protocol": {
      "const": "geoagent-isolated-cpu-v2"
    },
    "profiles": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,79}$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/profile"
      }
    }
  },
  "required": [
    "protocol",
    "profiles"
  ],
  "$defs": {
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tool": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,79}$"
        },
        "source_root": {
          "type": "string",
          "minLength": 1
        },
        "private_root": {
          "type": "string",
          "minLength": 1
        },
        "input_root": {
          "type": "string",
          "minLength": 1
        },
        "output_root": {
          "type": "string",
          "minLength": 1
        },
        "python": {
          "type": "string",
          "minLength": 1
        },
        "python_realpath": {
          "type": "string",
          "minLength": 1
        },
        "python_prefix": {
          "type": "string",
          "minLength": 1
        },
        "python_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "python_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "worker": {
          "type": "string",
          "minLength": 1
        },
        "worker_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "module": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*$"
        },
        "callable": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "catalog": {
          "type": "string",
          "minLength": 1
        },
        "catalog_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source_files": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 4096,
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "requirements": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*==[A-Za-z0-9][A-Za-z0-9_.+!-]*$"
          }
        },
        "dependency_lock": {
          "type": "string",
          "minLength": 1
        },
        "dependency_lock_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "build_receipt": {
          "type": "string",
          "minLength": 1
        },
        "build_receipt_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source_closure_complete": {
          "const": true
        },
        "projects": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "PDAL",
              "GRASS",
              "CBC",
              "OTB",
              "6S",
              "ISCE2",
              "SNAPHU",
              "PySolid",
              "ecCodes"
            ]
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "version": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "root": {
                "type": "string",
                "minLength": 1
              },
              "executable": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240,
                "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
              },
              "build_receipt": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240,
                "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
              },
              "closure_complete": {
                "const": true
              },
              "files_sha256": {
                "type": "object",
                "minProperties": 1,
                "maxProperties": 4096,
                "propertyNames": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 240,
                  "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
                },
                "additionalProperties": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            },
            "required": [
              "version",
              "root",
              "executable",
              "build_receipt",
              "closure_complete",
              "files_sha256"
            ]
          }
        },
        "artifact_rules": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "glob": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "validator_id": {
                "enum": [
                  "text_utf8",
                  "json",
                  "csv",
                  "png",
                  "geotiff",
                  "hdf5"
                ]
              }
            },
            "required": [
              "glob",
              "validator_id"
            ]
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "timeout_seconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3600
            },
            "memory_bytes": {
              "type": "integer",
              "minimum": 67108864,
              "maximum": 17179869184
            },
            "request_bytes": {
              "type": "integer",
              "minimum": 1024,
              "maximum": 4000000
            },
            "response_json_bytes": {
              "type": "integer",
              "minimum": 1024,
              "maximum": 4000000
            },
            "stderr_bytes": {
              "type": "integer",
              "minimum": 1024,
              "maximum": 1048576
            },
            "input_bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 134217728
            },
            "input_files": {
              "type": "integer",
              "minimum": 1,
              "maximum": 256
            },
            "output_bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 134217728
            },
            "output_files": {
              "type": "integer",
              "minimum": 1,
              "maximum": 64
            },
            "file_bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 67108864
            }
          },
          "required": [
            "timeout_seconds",
            "memory_bytes",
            "request_bytes",
            "response_json_bytes",
            "stderr_bytes",
            "input_bytes",
            "input_files",
            "output_bytes",
            "output_files",
            "file_bytes"
          ]
        }
      },
      "required": [
        "tool",
        "source_root",
        "private_root",
        "input_root",
        "output_root",
        "python",
        "python_realpath",
        "python_prefix",
        "python_sha256",
        "python_version",
        "worker",
        "worker_sha256",
        "module",
        "callable",
        "catalog",
        "catalog_sha256",
        "source_files",
        "requirements",
        "dependency_lock",
        "dependency_lock_sha256",
        "build_receipt",
        "build_receipt_sha256",
        "source_closure_complete",
        "projects",
        "artifact_rules",
        "limits"
      ]
    },
    "build_receipt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profile_id": {
          "type": "string",
          "minLength": 1
        },
        "python_version": {
          "type": "string",
          "minLength": 1
        },
        "python_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "dependency_lock_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "license_review_complete": {
          "const": true
        },
        "source_closure_complete": {
          "const": true
        },
        "projects": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "profile_id",
        "python_version",
        "python_sha256",
        "dependency_lock_sha256",
        "license_review_complete",
        "source_closure_complete",
        "projects"
      ]
    },
    "native_receipt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "project": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "license_review_complete": {
          "const": true
        },
        "closure_complete": {
          "const": true
        }
      },
      "required": [
        "project",
        "version",
        "license_review_complete",
        "closure_complete"
      ]
    }
  }
}
