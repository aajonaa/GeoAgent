{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "status": {
      "const": "source_authored_local_contract_results_not_science_accepted"
    },
    "baseline_precondition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
        },
        "sha256_before": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "sha256_after": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "path",
        "sha256_before",
        "sha256_after"
      ]
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "path",
          "sha256",
          "bytes"
        ]
      }
    },
    "test_report": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
    },
    "test_exit_code": {
      "type": "integer"
    },
    "science_acceptance": {
      "const": "not_run"
    },
    "real_gpr_cross_interpreter": {
      "const": "not_run"
    },
    "deployed": {
      "const": false
    },
    "submitted": {
      "const": false
    },
    "manifest_self_hash_excluded": {
      "const": true
    }
  },
  "required": [
    "status",
    "baseline_precondition",
    "files",
    "test_report",
    "test_exit_code",
    "science_acceptance",
    "real_gpr_cross_interpreter",
    "deployed",
    "submitted",
    "manifest_self_hash_excluded"
  ]
}
