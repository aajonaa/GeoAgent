          "lag_count",
          "bandwidth_m"
        ],
        "properties": {
          "x_m": {
            "type": "array",
            "minItems": 2,
            "maxItems": 512,
            "items": {
              "type": "number",
              "minimum": -10000000.0,
              "maximum": 10000000.0
            }
          },
          "y_m": {
            "type": "array",
            "minItems": 2,
            "maxItems": 512,
            "items": {
              "type": "number",
              "minimum": -10000000.0,
              "maximum": 10000000.0
            }
          },
          "z_m": {
            "type": "array",
            "minItems": 2,
            "maxItems": 512,
            "items": {
              "type": "number",
              "minimum": -10000000.0,
              "maximum": 10000000.0
            }
          },
          "values": {
            "type": "array",
            "minItems": 2,
            "maxItems": 512,
            "items": {
              "type": "number",
              "minimum": -1000000000000.0,
              "maximum": 1000000000000.0
            }
          },
          "axis": {
            "type": "string",
            "enum": [
              "x",
              "y",
              "z"
            ],
            "default": "x"
          },
          "lag_separation_m": {
            "type": "number",
            "minimum": 1e-06,
            "maximum": 10000000.0
          },
          "lag_width_m": {
            "type": "number",
            "minimum": 1e-06,
            "maximum": 10000000.0
          },
          "first_lag_m": {
            "type": "number",
            "minimum": 1e-06,
            "maximum": 10000000.0
          },
          "lag_count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 64
          },
          "bandwidth_m": {
            "type": "number",
            "minimum": 1e-06,
            "maximum": 10000000.0
          },
          "value_unit": {
            "type": "string",
            "enum": [
