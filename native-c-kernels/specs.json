              "type": "number",
              "minimum": -1000000000000.0,
              "maximum": 1000000000000.0
            }
          },
          "sampling_interval_s": {
            "type": "number",
            "exclusiveMinimum": 1e-09,
            "maximum": 86400
          },
          "amplitude_unit": {
            "type": "string",
            "enum": [
              "arbitrary",
              "m",
              "m/s",
              "Pa"
            ],
            "default": "arbitrary"
          }
        }
      },
      "constraints": [
        "2 to 4096 finite real samples.",
        "Original float32 arithmetic is retained; conversion to JSON numbers does not create double-precision results.",
        "Full signed frequency axis; the even-N Nyquist bin is negative."
