{
  "tools": [
    {
      "name": "HydroVICPrecipitationPhase",
      "project_id": 39,
      "project": "VIC",
      "description": "Partition precipitation into liquid rain and snow using the original VIC air-temperature phase kernel. Not a full VIC simulation.",
      "entrypoint": "adapters.HydroVICPrecipitationPhase",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "air_temperature_c",
          "precipitation_mm"
        ],
        "properties": {
          "air_temperature_c": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4096,
            "items": {
              "type": "number",
              "minimum": -100,
              "maximum": 100
            }
          },
          "precipitation_mm": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4096,
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 100000
            }
          },
          "max_snow_temperature_c": {
            "type": "number",
            "minimum": -100,
            "maximum": 100,
            "default": 1.0
          },
          "min_rain_temperature_c": {
            "type": "number",
            "minimum": -100,
            "maximum": 100,
            "default": -1.0
          }
        }
      },
      "constraints": [
        "Arrays must have equal lengths.",
        "max_snow_temperature_c > min_rain_temperature_c.",
        "Precipitation is a depth per supplied time step; no rate or temperature conversion."
      ],
      "example_arguments": {
        "air_temperature_c": [
          -2,
          -1,
          0,
          1,
          2
        ],
        "precipitation_mm": [
          10,
          10,
          10,
          10,
          10
        ]
      },
      "output_fields": {
        "rain_mm": "array[number]",
        "snow_mm": "array[number]",
        "sample_count": "integer"
      },
      "units": {
        "rain_mm": "mm/time_step",
        "snow_mm": "mm/time_step",
        "air_temperature_c": "degree_Celsius"
      },
      "library": "libvic_phase.so",
      "symbol": "geo_vic_partition",
      "precision": "upstream double",
      "license": "MIT",
      "generates_artifacts": false,
      "source_mode": "original_native_kernel",
      "runtime_install": false,
      "runtime_compile": false,
      "network_required": false,
      "gpu_required": false,
      "errors": {
        "invalid_arguments": "Invalid schema, nonfinite values or domain constraints.",
        "missing_dependency": "Prepared fixed native library is absent.",
        "integrity_error": "Source, bridge or prepared binary no longer matches the build receipt.",
        "execution_error": "Native allocation or execution failed."
      },
      "output_schema": {
        "type": "object",
        "required": [
          "rain_mm",
          "snow_mm",
          "sample_count",
          "units",
          "provenance"
        ],
        "properties": {
          "rain_mm": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "snow_mm": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "sample_count": {
            "type": "integer"
          },
          "units": {
            "type": "object"
          },
          "provenance": {
            "type": "object"
          }
        }
      }
    },
    {
      "name": "SeismicMadagascarFFT",
      "project_id": 131,
      "project": "Madagascar",
      "description": "Analyze a real seismic trace with the unchanged archived Madagascar Kiss FFT C kernel. Full unscaled forward DFT, no padding/window/detrending. Not the whole Madagascar suite.",
      "entrypoint": "adapters.SeismicMadagascarFFT",
      "input_schema": {
